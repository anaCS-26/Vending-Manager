# This project's dependency tree does not resolve under strict peer-dependency
# rules, so package-lock.json is generated with legacy (npm 6 style) peer
# resolution. That setting previously lived only in the maintainer's
# ~/.npmrc, which meant the lockfile was valid on exactly one machine: CI
# rejected it with EUSAGE ("lock file's magicast@0.5.2 does not satisfy
# magicast@0.3.5" — c12 declares magicast as an optional peer, and only the
# hoisted copy for @vitest/coverage-v8 was in the tree).
#
# Committing it here makes local installs, GitHub Actions and Vercel all
# resolve the same way. Removing this line means regenerating package-lock.json
# and resolving the peer conflicts for real.
legacy-peer-deps=true
