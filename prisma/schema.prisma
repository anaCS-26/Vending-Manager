// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Item {
  id                   Int                   @id @default(autoincrement())
  name                 String
  category             String
  bulk_format          String?
  sku                  String
  price                Float                 @default(0.0)
  imageUrl             String?
  WarehouseStock       WarehouseStock[]
  DispatchItems        DispatchItem[]
  RefillLogs           RefillLog[]
  PurchaseInvoiceItems PurchaseInvoiceItem[]
  InventoryAdjustments InventoryAdjustment[]
  MachineStock         MachineStock[]
  ReturnVerifications  ReturnVerification[]
  PurchaseOrderItems   PurchaseOrderItem[]
}

model Warehouse {
  id            Int              @id @default(autoincrement())
  name          String
  location      String?
  address       String?
  latitude      Float?
  longitude     Float?
  Stock         WarehouseStock[]
  Dispatches    Dispatch[]
  PurchaseOrders PurchaseOrder[]
}

model WarehouseStock {
  id               Int       @id @default(autoincrement())
  warehouseId      Int
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  itemId           Int
  item             Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity_on_hand Int       @default(0)
  pending_deficit  Int       @default(0)

  @@unique([warehouseId, itemId])
}

model Machine {
  id            Int            @id @default(autoincrement())
  location_name String
  district      String
  address       String?
  latitude      Float?
  longitude     Float?
  notes         String?
  terminalId    String?        @unique // e.g., Nayax terminal ID
  locationRent  Float          @default(0.0)
  adminExpenses Float          @default(0.0)
  RefillLogs    RefillLog[]
  Stock         MachineStock[]
}

model MachineStock {
  id               Int      @id @default(autoincrement())
  machineId        Int
  machine          Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  itemId           Int
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  capacity         Int      @default(10) // Maximum capacity for this item in the machine
  estimated_stock  Int      @default(0)
  last_refilled_at DateTime @default(now())

  @@unique([machineId, itemId])
}

model Driver {
  id         Int        @id @default(autoincrement())
  name       String
  phone      String?
  email      String?
  Dispatches Dispatch[]
}

model Dispatch {
  id            Int            @id @default(autoincrement())
  driverId      Int
  driver        Driver         @relation(fields: [driverId], references: [id])
  warehouseId   Int?           // Optional temporarily for migration, should be required
  warehouse     Warehouse?     @relation(fields: [warehouseId], references: [id])
  dispatch_date DateTime       @default(now())
  status        String         @default("OPEN") // OPEN, CLOSED
  DispatchItems DispatchItem[]
  RefillLogs    RefillLog[]
  ReturnVerifications ReturnVerification[]

  @@index([status])
  @@index([driverId])
  @@index([warehouseId])
  @@index([dispatch_date])
}

model DispatchItem {
  id                Int      @id @default(autoincrement())
  dispatchId        Int
  dispatch          Dispatch @relation(fields: [dispatchId], references: [id])
  itemId            Int
  item              Item     @relation(fields: [itemId], references: [id])
  quantity_given    Int      @default(0)
  quantity_returned Int      @default(0)
  quantity_damaged  Int      @default(0)
  price_at_dispatch Float    @default(0.0)

  @@index([dispatchId])
  @@index([itemId])
}

model RefillLog {
  id                            Int      @id @default(autoincrement())
  dispatchId                    Int
  dispatch                      Dispatch @relation(fields: [dispatchId], references: [id])
  machineId                     Int
  machine                       Machine  @relation(fields: [machineId], references: [id])
  itemId                        Int
  item                          Item     @relation(fields: [itemId], references: [id])
  quantity_refilled             Int
  items_sold_since_last_refill  Int?     // User driven tracker to accurately estimate machine stock
  damaged_quantity              Int      @default(0) // Track pulled damaged items
  expired_quantity              Int      @default(0) // Track pulled expired items
  refilled_at                   DateTime @default(now())

  @@index([dispatchId])
  @@index([machineId])
  @@index([refilled_at])
}

model ReturnVerification {
  id            Int      @id @default(autoincrement())
  dispatchId    Int
  dispatch      Dispatch @relation(fields: [dispatchId], references: [id])
  itemId        Int
  item          Item     @relation(fields: [itemId], references: [id])
  quantity      Int
  reason        String   // DAMAGED, EXPIRED
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reported_at   DateTime @default(now())
  verified_at   DateTime?
  notes         String?

  @@index([dispatchId])
  @@index([status])
}

model Supplier {
  id               Int               @id @default(autoincrement())
  name             String
  vatNumber        String?
  contactInfo      String?
  PurchaseInvoices PurchaseInvoice[]
}

model PurchaseInvoice {
  id            Int                   @id @default(autoincrement())
  supplierId    Int
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  invoiceNumber String                @unique
  date          DateTime              @default(now())
  totalAmount   Float                 @default(0.0)
  vatAmount     Float                 @default(0.0)
  returnAmount  Float                 @default(0.0)
  notes         String?
  Items         PurchaseInvoiceItem[]

  @@index([supplierId])
  @@index([date])
}

model PurchaseInvoiceItem {
  id           Int             @id @default(autoincrement())
  invoiceId    Int
  invoice      PurchaseInvoice @relation(fields: [invoiceId], references: [id])
  itemId       Int
  item         Item            @relation(fields: [itemId], references: [id])
  quantity     Int
  pricePerUnit Float

  @@index([invoiceId])
  @@index([itemId])
}

model CustomerRefund {
  id            Int       @id @default(autoincrement())
  refundNumber  String // e.g., the SR# or phone number
  phoneNumber   String?
  itemPrice     Float     @default(0.0)
  status        String    @default("PENDING") // PENDING, DONE
  receivedMoney Float?    @default(0.0)
  dateReceived  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

model InventoryAdjustment {
  id                Int      @id @default(autoincrement())
  itemId            Int
  item              Item     @relation(fields: [itemId], references: [id])
  quantity          Int
  reason            String // DAMAGED, EXPIRED, OFFICE_USE
  locationName      String? // Where it happened (e.g., machine name or warehouse)
  priceAtAdjustment Float    @default(0.0)
  date              DateTime @default(now())

  @@index([itemId])
  @@index([reason])
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  warehouseId  Int
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  status       String              @default("PENDING") // PENDING, COMPLETED, CANCELLED
  createdAt    DateTime            @default(now())
  completedAt  DateTime?
  Items        PurchaseOrderItem[]

  @@index([warehouseId])
  @@index([status])
}

model PurchaseOrderItem {
  id                 Int           @id @default(autoincrement())
  purchaseOrderId    Int
  purchaseOrder      PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  itemId             Int
  item               Item          @relation(fields: [itemId], references: [id])
  quantityRequested  Int
  quantityReceived   Int           @default(0)
  costPerUnit        Float         @default(0.0)

  @@index([purchaseOrderId])
  @@index([itemId])
}
