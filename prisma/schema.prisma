generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Represents a product saleable in vending machines.
model Item {
  id                   Int                   @id @default(autoincrement())
  name                 String
  category             String
  bulk_format          String?
  sku                  String
  // Pricing tiers
  price_standard       Float                 @default(0.0)
  price_hospital       Float                 @default(0.0)
  price_hotel          Float                 @default(0.0)
  cost                 Float                 @default(0.0)
  last_purchase_cost   Float                 @default(0.0)
  imageUrl             String?
  // Relations
  DispatchItems        DispatchItem[]
  InventoryAdjustments InventoryAdjustment[]
  MachineStock         MachineStock[]
  PurchaseInvoiceItems PurchaseInvoiceItem[]
  PurchaseOrderItems   PurchaseOrderItem[]
  RefillLogs           RefillLog[]
  ReturnVerifications  ReturnVerification[]
  WarehouseStock       WarehouseStock[]
  DriverStock          DriverStock[]
  isActive             Boolean               @default(true)
}

/// A storage facility where items are received from suppliers.
model Warehouse {
  id             Int              @id @default(autoincrement())
  name           String
  location       String?
  address        String?
  latitude       Float?
  longitude      Float?
  operating_cost Float            @default(0.0)
  rental_cost    Float            @default(0.0)
  Dispatches     Dispatch[]
  PurchaseOrders PurchaseOrder[]
  Stock          WarehouseStock[]
  isActive       Boolean          @default(true)
}

/// Tracks stock levels of an Item in a Warehouse.
model WarehouseStock {
  id               Int       @id @default(autoincrement())
  warehouseId      Int
  itemId           Int
  quantity_on_hand Int       @default(0)
  pending_deficit  Int       @default(0) // Stock reserved for open POs or dispatches
  item             Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, itemId])
  @@index([itemId])
}

/// A Physical vending machine at a specific location.
model Machine {
  id             Int            @id @default(autoincrement())
  location_name  String
  district       String
  address        String?
  latitude       Float?
  longitude      Float?
  notes          String?
  terminalId     String?        @unique
  serial_number  String?
  manufacturer   String?
  operating_cost Float          @default(0.0)
  rental_cost    Float          @default(0.0)
  tier           String         @default("STANDARD") // Pricing tier: STANDARD, HOSPITAL, HOTEL
  Stock          MachineStock[]
  RefillLogs     RefillLog[]
  isActive       Boolean        @default(true)
}

/// Tracks estimated stock and capacity of an Item in a Machine.
model MachineStock {
  id               Int      @id @default(autoincrement())
  machineId        Int
  itemId           Int
  estimated_stock  Int      @default(0)
  last_refilled_at DateTime @default(now())
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  machine          Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, itemId])
  @@index([itemId])
}

/// User who delivers items and refills machines.
model Driver {
  id          Int           @id @default(autoincrement())
  name        String
  phone       String?       @unique
  email       String?
  pin         String? // Hashed login PIN
  Dispatches  Dispatch[]
  DriverStock DriverStock[]
  isActive    Boolean       @default(true)
}

/// Items currently in the driver's possession (e.g., in their vehicle).
model DriverStock {
  id               Int      @id @default(autoincrement())
  driverId         Int
  itemId           Int
  quantity_on_hand Int      @default(0)
  updatedAt        DateTime @default(now()) @updatedAt
  driver           Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([driverId, itemId])
}

/// A request to move items from a Warehouse to a Driver.
model Dispatch {
  id                  Int                  @id @default(autoincrement())
  driverId            Int
  warehouseId         Int?
  dispatch_date       DateTime             @default(now())
  status              String               @default("OPEN") // OPEN, CLOSED
  driver              Driver               @relation(fields: [driverId], references: [id])
  warehouse           Warehouse?           @relation(fields: [warehouseId], references: [id])
  DispatchItems       DispatchItem[]
  RefillLogs          RefillLog[]
  ReturnVerifications ReturnVerification[]

  @@index([status])
  @@index([driverId])
  @@index([warehouseId])
  @@index([dispatch_date])
}

/// Specific item and quantity assigned in a Dispatch.
model DispatchItem {
  id                Int      @id @default(autoincrement())
  dispatchId        Int
  itemId            Int
  quantity_given    Int      @default(0)
  quantity_returned Int      @default(0)
  quantity_damaged  Int      @default(0)
  price_at_dispatch Float    @default(0.0) // Captured price at time of assignment
  dispatch          Dispatch @relation(fields: [dispatchId], references: [id])
  item              Item     @relation(fields: [itemId], references: [id])

  @@index([dispatchId])
  @@index([itemId])
}

/// Records a driver refilling an Item into a Machine during a Dispatch.
model RefillLog {
  id                           Int      @id @default(autoincrement())
  dispatchId                   Int?
  machineId                    Int
  itemId                       Int
  quantity_refilled            Int
  items_sold_since_last_refill Int?
  sales_revenue                Float    @default(0.0)
  price_at_refill              Float    @default(0.0)
  cost_at_refill               Float    @default(0.0)
  damaged_quantity             Int      @default(0)
  expired_quantity             Int      @default(0)
  refilled_at                  DateTime @default(now())
  dispatch                     Dispatch? @relation(fields: [dispatchId], references: [id])
  item                         Item     @relation(fields: [itemId], references: [id])
  machine                      Machine  @relation(fields: [machineId], references: [id])

  @@index([itemId])
  @@index([dispatchId])
  @@index([machineId])
  @@index([refilled_at])
}

/// Request for admin to verify items returned by a Driver.
model ReturnVerification {
  id          Int       @id @default(autoincrement())
  dispatchId  Int
  itemId      Int
  quantity    Int
  reason      String // DAMAGED, EXPIRED, SURPLUS
  status      String    @default("PENDING") // PENDING, VERIFIED
  reported_at DateTime  @default(now())
  verified_at DateTime?
  notes       String?
  dispatch    Dispatch  @relation(fields: [dispatchId], references: [id])
  item        Item      @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([dispatchId])
  @@index([status])
}

/// Entity providing items for purchase.
model Supplier {
  id               Int               @id @default(autoincrement())
  name             String
  vatNumber        String?
  contactInfo      String?
  PurchaseInvoices PurchaseInvoice[]
  isActive         Boolean           @default(true)
}

/// Financial document for items bought from a Supplier.
model PurchaseInvoice {
  id            Int                   @id @default(autoincrement())
  supplierId    Int
  invoiceNumber String                @unique
  date          DateTime              @default(now())
  totalAmount   Float                 @default(0.0)
  vatAmount     Float                 @default(0.0)
  returnAmount  Float                 @default(0.0)
  notes         String?
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  Items         PurchaseInvoiceItem[]

  @@index([supplierId])
  @@index([date])
}

/// Line item in a Purchase Invoice.
model PurchaseInvoiceItem {
  id           Int             @id @default(autoincrement())
  invoiceId    Int
  itemId       Int
  quantity     Int
  pricePerUnit Float
  invoice      PurchaseInvoice @relation(fields: [invoiceId], references: [id])
  item         Item            @relation(fields: [itemId], references: [id])

  @@index([invoiceId])
  @@index([itemId])
}

/// External log for any manual stock changes.
model InventoryAdjustment {
  id                Int      @id @default(autoincrement())
  itemId            Int
  quantity          Int
  reason            String
  locationName      String?
  priceAtAdjustment Float    @default(0.0)
  date              DateTime @default(now())
  item              Item     @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([reason])
}

/// Request to buy items from a supplier for a specific Warehouse.
model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  warehouseId Int
  status      String              @default("PENDING") // PENDING, COMPLETED
  createdAt   DateTime            @default(now())
  completedAt DateTime?
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  Items       PurchaseOrderItem[]

  @@index([warehouseId])
  @@index([status])
}

/// Specific item and quantity requested in a Purchase Order.
model PurchaseOrderItem {
  id                Int           @id @default(autoincrement())
  purchaseOrderId   Int
  itemId            Int
  quantityRequested Int
  quantityReceived  Int           @default(0)
  costPerUnit       Float         @default(0.0)
  item              Item          @relation(fields: [itemId], references: [id])
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
  @@index([itemId])
}

/// System administrator account.
model Admin {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  name             String?
  password         String
  role             String    @default("ADMIN")
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Single-row table holding a version counter that bumps on every data
/// mutation (via notifyClients()). The browser subscribes to this row's
/// updates over Supabase Realtime to know when to refresh the dashboard.
/// Replaces the previous Upstash-polled counter.
model SystemMeta {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  version   BigInt   @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

/// Universal ledger for tracking system mutations
model SystemAuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int?
  actorRole   String   // "ADMIN", "SYSTEM"
  actionType  String
  entityType  String
  entityId    Int?
  oldState    Json?
  newState    Json?
  timestamp   DateTime @default(now())
  message     String?

  @@index([actionType])
  @@index([entityType, entityId])
}
