generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Represents a product saleable in vending machines.
model Item {
  id                     Int                    @id @default(autoincrement())
  name                   String
  category               String
  bulk_format            String?
  sku                    String
  // Pricing tiers
  price_standard         Float                  @default(0.0)
  price_hospital         Float                  @default(0.0)
  price_hotel            Float                  @default(0.0)
  cost                   Float                  @default(0.0)
  last_purchase_cost     Float                  @default(0.0)
  // Default quantity prefilled when an admin clicks "+" to add this item to a
  // driver's bag. 0 = no default (admin types manually). Sourced from the
  // client's case-pack list; see scripts/seed-default-assignment-qty.ts.
  default_assignment_qty Int                    @default(0)
  imageUrl               String?
  // Relations
  DispatchItems          DispatchItem[]
  InventoryAdjustments   InventoryAdjustment[]
  MachineStock           MachineStock[]
  PurchaseInvoiceItems   PurchaseInvoiceItem[]
  PurchaseOrderItems     PurchaseOrderItem[]
  RefillLogs             RefillLog[]
  ReturnVerifications    ReturnVerification[]
  WarehouseStock         WarehouseStock[]
  DriverStock            DriverStock[]
  StockAssignments       StockAssignment[]
  DispatchTemplateItems  DispatchTemplateItem[]
  isActive               Boolean                @default(true)
}

/// A storage facility where items are received from suppliers.
model Warehouse {
  id               Int               @id @default(autoincrement())
  name             String
  location         String?
  address          String?
  latitude         Float?
  longitude        Float?
  operating_cost   Float             @default(0.0)
  rental_cost      Float             @default(0.0)
  Dispatches       Dispatch[]
  PurchaseOrders   PurchaseOrder[]
  Stock            WarehouseStock[]
  StockAssignments StockAssignment[]
  isActive         Boolean           @default(true)
}

/// Tracks stock levels of an Item in a Warehouse.
model WarehouseStock {
  id               Int       @id @default(autoincrement())
  warehouseId      Int
  itemId           Int
  quantity_on_hand Int       @default(0)
  pending_deficit  Int       @default(0) // Stock reserved for open POs or dispatches
  item             Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, itemId])
  @@index([itemId])
}

/// A Physical vending machine at a specific location.
model Machine {
  id                  Int                  @id @default(autoincrement())
  location_name       String
  district            String
  address             String?
  latitude            Float?
  longitude           Float?
  notes               String?
  terminalId          String?              @unique
  serial_number       String?
  manufacturer        String?
  operating_cost      Float                @default(0.0)
  rental_cost         Float                @default(0.0)
  tier                String               @default("STANDARD") // Pricing tier: STANDARD, HOSPITAL, HOTEL
  Stock               MachineStock[]
  RefillLogs          RefillLog[]
  ReturnVerifications ReturnVerification[]
  isActive            Boolean              @default(true)
}

/// Tracks estimated stock and capacity of an Item in a Machine.
model MachineStock {
  id               Int      @id @default(autoincrement())
  machineId        Int
  itemId           Int
  estimated_stock  Int      @default(0)
  last_refilled_at DateTime @default(now())
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  machine          Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, itemId])
  @@index([itemId])
}

/// User who delivers items and refills machines.
model Driver {
  id                  Int                  @id @default(autoincrement())
  name                String
  phone               String?              @unique
  email               String?
  pin                 String? // Hashed login PIN
  Dispatches          Dispatch[]
  DriverStock         DriverStock[]
  StockAssignments    StockAssignment[]
  RefillLogs          RefillLog[]
  ReturnVerifications ReturnVerification[]
  PushSubscriptions   PushSubscription[]
  isActive            Boolean              @default(true)
}

/// Items currently in the driver's possession (e.g., in their vehicle).
model DriverStock {
  id               Int      @id @default(autoincrement())
  driverId         Int
  itemId           Int
  quantity_on_hand Int      @default(0)
  updatedAt        DateTime @default(now()) @updatedAt
  driver           Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([driverId, itemId])
  // Sibling of WarehouseStock/MachineStock, both of which index itemId. This one
  // was missed, so the per-item `aggregate({ where: { itemId } })` calls in
  // completePurchaseOrder and calibrateWarehouseStock each did a seq scan.
  @@index([itemId])
}

/// A request to move items from a Warehouse to a Driver.
model Dispatch {
  id                  Int                  @id @default(autoincrement())
  driverId            Int
  warehouseId         Int?
  dispatch_date       DateTime             @default(now())
  status              String               @default("OPEN") // OPEN, CLOSED
  driver              Driver               @relation(fields: [driverId], references: [id])
  warehouse           Warehouse?           @relation(fields: [warehouseId], references: [id])
  DispatchItems       DispatchItem[]
  RefillLogs          RefillLog[]
  ReturnVerifications ReturnVerification[]

  @@index([status])
  @@index([driverId])
  @@index([warehouseId])
  @@index([dispatch_date])
  // getClosedDispatches / getClosedDispatchesPaginated filter status then sort by date.
  @@index([status, dispatch_date])
}

/// Specific item and quantity assigned in a Dispatch.
model DispatchItem {
  id                Int      @id @default(autoincrement())
  dispatchId        Int
  itemId            Int
  quantity_given    Int      @default(0)
  quantity_returned Int      @default(0)
  quantity_damaged  Int      @default(0)
  price_at_dispatch Float    @default(0.0) // Captured price at time of assignment
  dispatch          Dispatch @relation(fields: [dispatchId], references: [id])
  item              Item     @relation(fields: [itemId], references: [id])

  @@index([dispatchId])
  @@index([itemId])
}

/// A reusable named preset of item quantities for driver stock pushes.
/// Pure configuration — nothing historical references it (assignToDriver
/// snapshots its own StockAssignment rows), so deletes are hard deletes.
model DispatchTemplate {
  id        Int                    @id @default(autoincrement())
  name      String
  createdAt DateTime               @default(now())
  updatedAt DateTime               @default(now()) @updatedAt
  Items     DispatchTemplateItem[]
}

/// One item line inside a DispatchTemplate.
model DispatchTemplateItem {
  id         Int              @id @default(autoincrement())
  templateId Int
  itemId     Int
  quantity   Int
  template   DispatchTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  item       Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([templateId, itemId])
  @@index([templateId])
  @@index([itemId])
}

/// Records a driver refilling an Item into a Machine. Originally tied to a Dispatch;
/// after the dispatchless refactor (Phase B) new rows carry a direct driverId
/// instead. Both columns coexist so legacy rows remain queryable.
model RefillLog {
  id                           Int       @id @default(autoincrement())
  dispatchId                   Int?
  driverId                     Int?
  machineId                    Int
  itemId                       Int
  quantity_refilled            Int
  items_sold_since_last_refill Int?
  sales_revenue                Float     @default(0.0)
  price_at_refill              Float     @default(0.0)
  cost_at_refill               Float     @default(0.0)
  damaged_quantity             Int       @default(0)
  expired_quantity             Int       @default(0)
  refilled_at                  DateTime  @default(now())
  /// Client-generated idempotency key for the driver's offline replay queue. If a
  /// batch commits but the response is lost (dropped signal, lambda timeout), the
  /// client still has it queued and retries — without this the refill is committed
  /// twice, double-counting revenue.
  ///
  /// Uniqueness is (clientRequestId, itemId), NOT clientRequestId alone: one batch
  /// writes one row per item and they all share the key, so a bare @unique would
  /// reject the first legitimate multi-item batch. Nullable, and Postgres treats
  /// NULLs as distinct, so legacy rows and the online path are unaffected.
  clientRequestId              String?
  dispatch                     Dispatch? @relation(fields: [dispatchId], references: [id])
  driver                       Driver?   @relation(fields: [driverId], references: [id])
  item                         Item      @relation(fields: [itemId], references: [id])
  machine                      Machine   @relation(fields: [machineId], references: [id])

  @@unique([clientRequestId, itemId])
  @@index([itemId])
  @@index([dispatchId])
  @@index([driverId])
  @@index([machineId])
  @@index([refilled_at])
  // Composites for the filter+sort pairs the app actually issues. The five
  // single-column indexes above can't serve an ordered lookup on their own.
  @@index([machineId, itemId, refilled_at]) // last-price findFirst, per item during a refill
  @@index([machineId, refilled_at]) // machine history feeds
  @@index([driverId, refilled_at]) // per-driver last-activity + history slices
}

/// Request for admin to verify items returned by a Driver. dispatchId was
/// required in the legacy flow; in the dispatchless flow drivers return
/// directly against their bag, so dispatchId is nullable and driverId is
/// the authoritative source of "who returned this".
model ReturnVerification {
  id          Int       @id @default(autoincrement())
  dispatchId  Int?
  driverId    Int?
  machineId   Int?
  itemId      Int
  quantity    Int
  reason      String // DAMAGED, EXPIRED, SURPLUS
  status      String    @default("PENDING") // PENDING, VERIFIED
  reported_at DateTime  @default(now())
  verified_at DateTime?
  notes       String?
  dispatch    Dispatch? @relation(fields: [dispatchId], references: [id])
  driver      Driver?   @relation(fields: [driverId], references: [id])
  machine     Machine?  @relation(fields: [machineId], references: [id])
  item        Item      @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([dispatchId])
  @@index([driverId])
  @@index([machineId])
  @@index([status])
  // reported_at is the sole orderBy on the pending/processed return feeds, and
  // had no index at all.
  @@index([reported_at])
  @@index([status, reported_at])
}

/// Audit record for an admin-to-driver stock push (the dispatchless replacement
/// for DispatchItem-as-receipt). Each row is one item-quantity-driver event;
/// the driver acknowledges or disputes it via the ack banner.
model StockAssignment {
  id                 Int      @id @default(autoincrement())
  driverId           Int
  itemId             Int
  warehouseId        Int?
  quantity           Int
  cost_at_assignment Float    @default(0.0) // snapshot of Item.cost (WAC) at issue time
  notes              String?
  assigned_by        Int? // Admin.id (nullable for system-generated rows)
  assigned_at        DateTime @default(now())

  // Acknowledgment state — drives the driver-side ack banner.
  status           String    @default("PENDING_ACK") // PENDING_ACK, ACKNOWLEDGED, DISPUTED
  acknowledged_at  DateTime?
  acknowledged_qty Int? // What the driver says they actually received (null until acked)

  driver    Driver     @relation(fields: [driverId], references: [id])
  item      Item       @relation(fields: [itemId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([driverId])
  @@index([itemId])
  @@index([assigned_at])
  @@index([status])
  // warehouseId is an unindexed FK — it makes warehouse deletes scan this table.
  @@index([warehouseId])
  @@index([status, assigned_at]) // open-assignment work queue
  @@index([driverId, status, assigned_at]) // per-driver bag + dispute lookups
}

/// Entity providing items for purchase.
model Supplier {
  id               Int               @id @default(autoincrement())
  name             String
  vatNumber        String?
  contactInfo      String?
  PurchaseInvoices PurchaseInvoice[]
  isActive         Boolean           @default(true)
}

/// Financial document for items bought from a Supplier.
model PurchaseInvoice {
  id            Int                   @id @default(autoincrement())
  supplierId    Int
  invoiceNumber String                @unique
  date          DateTime              @default(now())
  totalAmount   Float                 @default(0.0)
  vatAmount     Float                 @default(0.0)
  returnAmount  Float                 @default(0.0)
  notes         String?
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  Items         PurchaseInvoiceItem[]

  @@index([supplierId])
  @@index([date])
}

/// Line item in a Purchase Invoice.
model PurchaseInvoiceItem {
  id           Int             @id @default(autoincrement())
  invoiceId    Int
  itemId       Int
  quantity     Int
  pricePerUnit Float
  invoice      PurchaseInvoice @relation(fields: [invoiceId], references: [id])
  item         Item            @relation(fields: [itemId], references: [id])

  @@index([invoiceId])
  @@index([itemId])
}

/// External log for any manual stock changes.
model InventoryAdjustment {
  id                Int      @id @default(autoincrement())
  itemId            Int
  quantity          Int
  reason            String
  locationName      String?
  priceAtAdjustment Float    @default(0.0)
  date              DateTime @default(now())
  item              Item     @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([reason])
}

/// Request to buy items from a supplier for a specific Warehouse.
model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  warehouseId Int
  status      String              @default("PENDING") // PENDING, COMPLETED
  createdAt   DateTime            @default(now())
  completedAt DateTime?
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  Items       PurchaseOrderItem[]

  @@index([warehouseId])
  @@index([status])
}

/// Specific item and quantity requested in a Purchase Order.
model PurchaseOrderItem {
  id                Int           @id @default(autoincrement())
  purchaseOrderId   Int
  itemId            Int
  quantityRequested Int
  quantityReceived  Int           @default(0)
  costPerUnit       Float         @default(0.0)
  item              Item          @relation(fields: [itemId], references: [id])
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
  @@index([itemId])
}

/// System administrator account.
model Admin {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  name              String?
  password          String
  role              String             @default("ADMIN")
  resetToken        String?            @unique
  resetTokenExpiry  DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  PushSubscriptions PushSubscription[]
}

/// A browser's Web Push registration, owned by exactly one Driver or Admin.
///
/// This table is the whole point of the feature: the endpoint URL and its two
/// keys are minted by the browser's push service and are the ONLY way to reach
/// a device that has the app closed. The predecessor kept them in a
/// process-global Map, so every serverless cold start (i.e. constantly, on
/// Vercel) silently dropped the fleet's registrations and no push ever landed.
///
/// `endpoint` is the natural key — the browser hands back the same URL for the
/// same registration, so upserting on it makes re-subscribing idempotent and
/// keeps one row per device rather than one per sign-in.
model PushSubscription {
  id       Int    @id @default(autoincrement())
  endpoint String @unique
  /// Client public key for payload encryption (ECDH P-256, base64url).
  p256dh   String
  /// Client auth secret for payload encryption (base64url).
  auth     String

  /// Owner. Exactly one of these is set — enforced in savePushSubscription,
  /// which derives the owner from the session and never from client input.
  driverId Int?
  adminId  Int?

  /// Diagnostic only, so an admin can tell two of their own devices apart.
  userAgent  String?
  createdAt  DateTime @default(now())
  /// Last time the push service accepted a delivery for this endpoint.
  lastSeenAt DateTime @default(now())
  /// Consecutive soft failures. Hard failures (404/410) delete the row
  /// outright; this counts the retryable ones so a permanently broken
  /// endpoint can be pruned without guessing.
  failureCount Int @default(0)

  driver Driver? @relation(fields: [driverId], references: [id], onDelete: Cascade)
  admin  Admin?  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([adminId])
}

/// De-duplication ledger for scheduled (non-event) notifications.
///
/// Event-driven pushes fire once because the event happens once. The
/// stock-alert cron has no such guarantee: the same machine-item stays at risk
/// every morning until someone refills it, and a notification that arrives
/// daily for a week is one the driver learns to swipe away. One row per
/// dedupe key records when we last warned, so runStockAlerts can re-warn only
/// after the machine was actually serviced (or after a hard ceiling).
model PushDedupe {
  id     Int      @id @default(autoincrement())
  /// e.g. `stockout:<machineId>:<itemId>`.
  key    String   @unique
  sentAt DateTime @default(now())
}

/// Single-row table holding a version counter that bumps on every data
/// mutation (via notifyClients()). The browser subscribes to this row's
/// updates over Supabase Realtime to know when to refresh the dashboard.
/// Replaces the previous Upstash-polled counter.
model SystemMeta {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  version   BigInt   @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

/// Universal ledger for tracking system mutations
model SystemAuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  actorRole  String // "ADMIN", "SYSTEM"
  actionType String
  entityType String
  entityId   Int?
  oldState   Json?
  newState   Json?
  timestamp  DateTime @default(now())
  message    String?

  @@index([actionType])
  @@index([entityType, entityId])
  // timestamp had no index despite being the sole orderBy on every audit query,
  // including the skip/take-paginated /super/audit viewer — which meant Postgres
  // re-sorted the whole table for each page. This table only ever grows.
  @@index([timestamp])
  @@index([actionType, timestamp]) // sensitive-action feed
  @@index([actorId, timestamp]) // per-actor last-activity rollups
}
