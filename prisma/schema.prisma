generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Item {
  id                   Int                   @id @default(autoincrement())
  name                 String
  category             String
  bulk_format          String?
  sku                  String
  price_standard       Float                 @default(0.0)
  price_hospital       Float                 @default(0.0)
  price_hotel          Float                 @default(0.0)
  cost                 Float                 @default(0.0)
  imageUrl             String?
  DispatchItems        DispatchItem[]
  InventoryAdjustments InventoryAdjustment[]
  MachineStock         MachineStock[]
  PurchaseInvoiceItems PurchaseInvoiceItem[]
  PurchaseOrderItems   PurchaseOrderItem[]
  RefillLogs           RefillLog[]
  ReturnVerifications  ReturnVerification[]
  WarehouseStock       WarehouseStock[]
  DriverStock          DriverStock[]
}

model Warehouse {
  id             Int              @id @default(autoincrement())
  name           String
  location       String?
  address        String?
  latitude       Float?
  longitude      Float?
  operating_cost Float            @default(0.0)
  rental_cost    Float            @default(0.0)
  Dispatches     Dispatch[]
  PurchaseOrders PurchaseOrder[]
  Stock          WarehouseStock[]
}

model WarehouseStock {
  id               Int       @id @default(autoincrement())
  warehouseId      Int
  itemId           Int
  quantity_on_hand Int       @default(0)
  pending_deficit  Int       @default(0)
  item             Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, itemId])
}

model Machine {
  id             Int            @id @default(autoincrement())
  location_name  String
  district       String
  address        String?
  latitude       Float?
  longitude      Float?
  notes          String?
  terminalId     String?        @unique
  serial_number  String?
  manufacturer   String?
  operating_cost Float          @default(0.0)
  rental_cost    Float          @default(0.0)
  tier           String         @default("STANDARD") // STANDARD, HOSPITAL, HOTEL
  Stock          MachineStock[]
  RefillLogs     RefillLog[]
}

model MachineStock {
  id               Int      @id @default(autoincrement())
  machineId        Int
  itemId           Int
  capacity         Int      @default(10)
  estimated_stock  Int      @default(0)
  last_refilled_at DateTime @default(now())
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  machine          Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, itemId])
}

model Driver {
  id          Int           @id @default(autoincrement())
  name        String
  phone       String?       @unique
  email       String?
  pin         String?
  Dispatches  Dispatch[]
  DriverStock DriverStock[]
}

model DriverStock {
  id               Int    @id @default(autoincrement())
  driverId         Int
  itemId           Int
  quantity_on_hand Int    @default(0)
  driver           Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  item             Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([driverId, itemId])
}

model Dispatch {
  id                  Int                  @id @default(autoincrement())
  driverId            Int
  warehouseId         Int?
  dispatch_date       DateTime             @default(now())
  status              String               @default("OPEN")
  driver              Driver               @relation(fields: [driverId], references: [id])
  warehouse           Warehouse?           @relation(fields: [warehouseId], references: [id])
  DispatchItems       DispatchItem[]
  RefillLogs          RefillLog[]
  ReturnVerifications ReturnVerification[]

  @@index([status])
  @@index([driverId])
  @@index([warehouseId])
  @@index([dispatch_date])
}

model DispatchItem {
  id                Int      @id @default(autoincrement())
  dispatchId        Int
  itemId            Int
  quantity_given    Int      @default(0)
  quantity_returned Int      @default(0)
  quantity_damaged  Int      @default(0)
  price_at_dispatch Float    @default(0.0)
  dispatch          Dispatch @relation(fields: [dispatchId], references: [id])
  item              Item     @relation(fields: [itemId], references: [id])

  @@index([dispatchId])
  @@index([itemId])
}

model RefillLog {
  id                           Int      @id @default(autoincrement())
  dispatchId                   Int
  machineId                    Int
  itemId                       Int
  quantity_refilled            Int
  items_sold_since_last_refill Int?
  price_at_refill              Float    @default(0.0)
  cost_at_refill               Float    @default(0.0)
  damaged_quantity             Int      @default(0)
  expired_quantity             Int      @default(0)
  refilled_at                  DateTime @default(now())
  dispatch                     Dispatch @relation(fields: [dispatchId], references: [id])
  item                         Item     @relation(fields: [itemId], references: [id])
  machine                      Machine  @relation(fields: [machineId], references: [id])

  @@index([dispatchId])
  @@index([machineId])
  @@index([refilled_at])
}

model ReturnVerification {
  id          Int       @id @default(autoincrement())
  dispatchId  Int
  itemId      Int
  quantity    Int
  reason      String
  status      String    @default("PENDING")
  reported_at DateTime  @default(now())
  verified_at DateTime?
  notes       String?
  dispatch    Dispatch  @relation(fields: [dispatchId], references: [id])
  item        Item      @relation(fields: [itemId], references: [id])

  @@index([dispatchId])
  @@index([status])
}

model Supplier {
  id               Int               @id @default(autoincrement())
  name             String
  vatNumber        String?
  contactInfo      String?
  PurchaseInvoices PurchaseInvoice[]
}

model PurchaseInvoice {
  id            Int                   @id @default(autoincrement())
  supplierId    Int
  invoiceNumber String                @unique
  date          DateTime              @default(now())
  totalAmount   Float                 @default(0.0)
  vatAmount     Float                 @default(0.0)
  returnAmount  Float                 @default(0.0)
  notes         String?
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  Items         PurchaseInvoiceItem[]

  @@index([supplierId])
  @@index([date])
}

model PurchaseInvoiceItem {
  id           Int             @id @default(autoincrement())
  invoiceId    Int
  itemId       Int
  quantity     Int
  pricePerUnit Float
  invoice      PurchaseInvoice @relation(fields: [invoiceId], references: [id])
  item         Item            @relation(fields: [itemId], references: [id])

  @@index([invoiceId])
  @@index([itemId])
}

model CustomerRefund {
  id            Int       @id @default(autoincrement())
  refundNumber  String
  phoneNumber   String?
  itemPrice     Float     @default(0.0)
  status        String    @default("PENDING")
  receivedMoney Float?    @default(0.0)
  dateReceived  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

model InventoryAdjustment {
  id                Int      @id @default(autoincrement())
  itemId            Int
  quantity          Int
  reason            String
  locationName      String?
  priceAtAdjustment Float    @default(0.0)
  date              DateTime @default(now())
  item              Item     @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([reason])
}

model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  warehouseId Int
  status      String              @default("PENDING")
  createdAt   DateTime            @default(now())
  completedAt DateTime?
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  Items       PurchaseOrderItem[]

  @@index([warehouseId])
  @@index([status])
}

model PurchaseOrderItem {
  id                Int           @id @default(autoincrement())
  purchaseOrderId   Int
  itemId            Int
  quantityRequested Int
  quantityReceived  Int           @default(0)
  costPerUnit       Float         @default(0.0)
  item              Item          @relation(fields: [itemId], references: [id])
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
  @@index([itemId])
}

model Admin {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  name             String?
  password         String
  role             String    @default("ADMIN")
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
