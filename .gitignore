# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Verifier logs
/linting_output.txt
/build_output.txt

# Databases
*.db
*.db-journal

# Database backups / dumps — never commit these
backups/

# Local Supabase CLI working directory (config + per-machine state)
supabase/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# SSE signal file
.sse/

# Local AI assistant state (Claude Code, Gemini CLI)
.claude/
.gemini/

# OpenNext
.open-next

# PWA files
public/sw.js
public/sw.js.map
public/swe-worker*.js
public/workbox-*.js
public/fallback-*.js

# Ignore sensitive client seed data
prisma/seed-data-templates/*.csv
prisma/seed-data-templates/*.xlsx

# Scripts and sensitive data tools
scripts/
